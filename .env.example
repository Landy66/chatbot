# Provider: "openai", "google" oder "groq"
LLM_PROVIDER=openai

# OpenAI Konfiguration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Google Gemini Konfiguration (Kostenloser Free Tier via Google AI Studio)
# API-Key kostenlos erstellen: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq Cloud Konfiguration (Kostenlos, hohes Kontingent: 1.000+ Anfragen/Tag)
# API-Key kostenlos erstellen: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

APP_HOST=127.0.0.1
APP_PORT=7860
LOG_LEVEL=INFO
MAX_INPUT_CHARS=8000
MAX_CONTEXT_TURNS=20
MAX_CONTEXT_CHARS=80000
MAX_UI_TURNS=100
MAX_OUTPUT_TOKENS=4096
RUN_TIMEOUT_SECONDS=120
MAX_RETRIES=2
MAX_CONCURRENT_RUNS=4
MAX_QUEUE_SIZE=16
